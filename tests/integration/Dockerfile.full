FROM python:3.12-slim

WORKDIR /app

# Install system dependencies for cryptography package
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl build-essential libffi-dev zstd && \
    rm -rf /var/lib/apt/lists/*

# Install Ollama
RUN curl -fsSL https://ollama.com/install.sh | sh

# Install cloneguard with all extras
COPY pyproject.toml README.md ./
COPY src/ src/
RUN pip install --no-cache-dir ".[all]"

# Copy ALL tests (unit + integration)
COPY tests/ tests/
RUN pip install --no-cache-dir pytest

# Copy integration test scripts
COPY tests/integration/run_tests.sh /run_tests.sh
COPY tests/integration/run_full_tests.sh /run_full_tests.sh
RUN chmod +x /run_tests.sh /run_full_tests.sh

RUN mkdir -p /repos

ENTRYPOINT ["/run_full_tests.sh"]
